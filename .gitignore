# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage

# The rendered site, and the 450 MB of reports fetched into `site/qc-reports/`.
# Every number the render publishes lives in docs/data/catalogue.json, which is
# committed and gated in CI; the reports are described by data/reports.csv and
# brought back verified by `gb-audit fetch`.
/site/

# Anchored, and NOT a pattern for `docs/templates/parts/`. A bare `parts/` -- what
# the usual Python .gitignore ships for setuptools -- has no leading slash, so git
# applies it at every depth and silently swallows the prose fragments the site is
# assembled from.
/parts/

# Editors and platforms
.DS_Store
.idea/
.vscode/
*.swp
